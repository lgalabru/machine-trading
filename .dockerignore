**/target
**/bin
# Built components: the image builds its own.
**/bot.wasm
.git
.env
.surfpool
jobs
# A task is a folder; the image builds the workspace members in it (the
# reference and the ladder's bots) and nothing of what agents mustn't see.
bench/tasks/*
!bench/tasks/*/reference
!bench/tasks/*/checks
bench/tasks/*/checks/*
!bench/tasks/*/checks/bots
bench/checks
skills
docs
# Images carry the gzipped snapshot; mtx decompresses it on first use.
snapshots/*/surfnet.json
