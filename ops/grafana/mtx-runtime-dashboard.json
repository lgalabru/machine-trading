{
  "title": "mtx runtime: strategies on mainnet",
  "uid": "mtx-runtime",
  "description": "The mtx live runtime (docs/rfd/0004): each strategy's steps, sends, position and PnL, the enforcer, the feed and the TPU. Traces: Tempo, service.name=mtx-runtime, span strategy.step.",
  "tags": [
    "mtx",
    "solana"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(mtx_feed_slot, service_name)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "strategy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(mtx_strategy_steps, strategy)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Strategies",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Steps per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (rate(mtx_strategy_steps{service_name=~\"$service\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Step time, slot to sheet sent (p50 / p99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(mtx_strategy_step_ms_bucket{service_name=~\"$service\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(mtx_strategy_step_ms_bucket{service_name=~\"$service\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sends by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy, outcome) (rate(mtx_strategy_sends{service_name=~\"$service\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Skipped steps",
      "description": "A step skipped because the one before still held the strategy: a strategy slower than its step.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (increase(mtx_strategy_steps_skipped{service_name=~\"$service\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Position",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_strategy_position{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PnL (mark-to-market estimate)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_strategy_pnl_usd{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drawdown",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_strategy_drawdown_usd{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running",
      "description": "1 while the strategy steps; 0 paused or stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_strategy_running{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Shadow strategies: paper fills",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Paper fills",
      "description": "A shadow strategy's orders, filled by the market's real trades: model=through counts trades past the quote (a lower bound), model=touch also those at its price (an upper bound).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy, model, side, liquidity) (increase(mtx_paper_fills{service_name=~\"$service\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}} {{model}} {{side}} {{liquidity}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "The market's trades (tape)",
      "description": "Phoenix's trades on the strategy's market, from the transactions the validator runs. Missed or undecoded above 0 means paper fills are under-counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (rate(mtx_tape_trades{service_name=~\"$service\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}} trades/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (rate(mtx_tape_missed{service_name=~\"$service\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}} missed/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (rate(mtx_tape_undecoded{service_name=~\"$service\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}} undecoded/s",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Markout by horizon (mean, bps)",
      "description": "How far the mid moved in the fill's favour 1, 10 and 60 s after it. Below 0: the fills are picked off (adverse selection).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy, model, horizon) (rate(mtx_paper_markout_bps_sum{service_name=~\"$service\", strategy=~\"$strategy\"}[15m])) / sum by (strategy, model, horizon) (rate(mtx_paper_markout_bps_count{service_name=~\"$service\", strategy=~\"$strategy\"}[15m]))",
          "legendFormat": "{{strategy}} {{model}} {{horizon}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Edge at fill (mean, bps)",
      "description": "How far each fill was on the good side of the mid when it filled: the spread captured before the market moves.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy, model, liquidity) (rate(mtx_paper_fill_edge_bps_sum{service_name=~\"$service\", strategy=~\"$strategy\"}[15m])) / sum by (strategy, model, liquidity) (rate(mtx_paper_fill_edge_bps_count{service_name=~\"$service\", strategy=~\"$strategy\"}[15m]))",
          "legendFormat": "{{strategy}} {{model}} {{liquidity}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quotes at the touch",
      "description": "The share of steps with a quote at or inside the book's best: the fills the trade-through model can't see happen there.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(mtx_paper_at_touch{service_name=~\"$service\", strategy=~\"$strategy\"}[5m])",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Paper position",
      "description": "The position the paper fills add up to, uncapped: the strategy quotes on its real position, which is 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_paper_position{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}} {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Paper PnL",
      "description": "Cash from the paper fills plus the paper position at the mid; before fees.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mtx_paper_pnl_usd{service_name=~\"$service\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}} {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Speed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Market read: waiting for the cache, decoding (mean)",
      "description": "A step's market read: the accounts taken from the cache under its lock, then decoded without it. mtx live latency has every stage of a step.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (symbol) (rate(mtx_read_lock_us_sum{service_name=~\"$service\"}[5m])) / sum by (symbol) (rate(mtx_read_lock_us_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{symbol}} lock",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (symbol) (rate(mtx_read_decode_us_sum{service_name=~\"$service\"}[5m])) / sum by (symbol) (rate(mtx_read_decode_us_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{symbol}} decode",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Journal lines dropped",
      "description": "A step's journal line, dropped because the journal's thread fell behind: the step didn't wait for it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (strategy) (increase(mtx_journal_dropped{service_name=~\"$service\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
