{
  "title": "mtx runtime: strategies on mainnet",
  "uid": "mtx-runtime",
  "description": "The mtx live runtime (docs/rfd/0004): each strategy's steps, sends, position and PnL, the enforcer, the feed and the TPU. Traces: Tempo, service.name=mtx-runtime, span strategy.step.",
  "tags": [
    "mtx",
    "solana"
  ],
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(mtx_feed_slot, job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "strategy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(mtx_strategy_steps_total, strategy)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Strategies",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Steps per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy) (rate(mtx_strategy_steps_total{job=~\"$job\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Step time, slot to sheet sent (p50 / p99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(mtx_strategy_step_ms_bucket{job=~\"$job\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(mtx_strategy_step_ms_bucket{job=~\"$job\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sends by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy, outcome) (rate(mtx_strategy_sends_total{job=~\"$job\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Skipped steps",
      "description": "A step skipped because the one before still held the strategy: a strategy slower than its step.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy) (increase(mtx_strategy_steps_skipped_total{job=~\"$job\", strategy=~\"$strategy\"}[5m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Position",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_strategy_position{job=~\"$job\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PnL (mark-to-market estimate)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_strategy_pnl_usd{job=~\"$job\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drawdown",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_strategy_drawdown_usd{job=~\"$job\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running",
      "description": "1 while the strategy steps; 0 paused or stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_strategy_running{job=~\"$job\", strategy=~\"$strategy\"}",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Enforcer and control",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Enforcer pauses",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy, reason) (increase(mtx_enforcer_pauses_total{job=~\"$job\", strategy=~\"$strategy\"}[1h]))",
          "legendFormat": "{{strategy}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Control commands",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (command, outcome) (increase(mtx_control_commands_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{command}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Feed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Slots behind the chain",
      "description": "Past 4, every strategy pauses: the runtime reads a market that has moved on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_feed_slots_behind{job=~\"$job\"}",
          "legendFormat": "behind",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dropped feed events",
      "description": "Above 0, every strategy pauses: the cache may be stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_feed_dropped{job=~\"$job\"}",
          "legendFormat": "dropped",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slot",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_feed_slot{job=~\"$job\"}",
          "legendFormat": "slot",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Strategies",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mtx_strategies{job=~\"$job\"}",
          "legendFormat": "strategies",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Sends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Shadow sends",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy, simulated) (rate(mtx_shadow_sends_total{job=~\"$job\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}} simulated={{simulated}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TPU sends by route",
      "description": "route=rpc is the fallback: no leader connection took the send.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (strategy, route) (rate(mtx_tpu_sends_total{job=~\"$job\", strategy=~\"$strategy\"}[1m]))",
          "legendFormat": "{{strategy}} {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TPU send to confirmed (p50 / p99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(mtx_tpu_confirm_ms_bucket{job=~\"$job\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(mtx_tpu_confirm_ms_bucket{job=~\"$job\", strategy=~\"$strategy\"}[5m])))",
          "legendFormat": "{{strategy}} p99",
          "refId": "B"
        }
      ]
    }
  ]
}