# The market-making mandate's probes: `just build` builds the two-sided
# maker into bot.wasm, `just build one-sided` (or `taker`, `crosser`) the
# others, each into its own folder's bot.wasm. `just process <probe>` builds
# one as a process bot.

# Build a probe into bot.wasm (`maker`), or into <probe>/bot.wasm.
build probe="maker":
    #!/usr/bin/env bash
    set -euo pipefail
    features=""
    dest="bot.wasm"
    if [ "{{probe}}" != "maker" ]; then
      features="--features {{probe}}"
      mkdir -p "{{probe}}"
      dest="{{probe}}/bot.wasm"
    fi
    wasm="$(cargo build --release --lib --target wasm32-wasip2 $features --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    cp "$wasm" "$dest"
    echo "built $dest from $wasm"

# Build a probe as a process bot into <probe>-process (bin/bot and a
# Justfile whose `run` starts it), which `mtx grade --trusted --bot` runs.
process probe="maker":
    #!/usr/bin/env bash
    set -euo pipefail
    features=""
    if [ "{{probe}}" != "maker" ]; then features="--features {{probe}}"; fi
    exe="$(cargo build --release --bin mtx-making-probe $features --message-format=json-render-diagnostics \
      | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -1)"
    mkdir -p "{{probe}}-process/bin"
    cp "$exe" "{{probe}}-process/bin/bot"
    printf 'run:\n    @exec ./bin/bot\n' > "{{probe}}-process/Justfile"
    echo "built {{probe}}-process/bin/bot"
