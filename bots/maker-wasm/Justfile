# A strategy component: `just build` builds it into bot.wasm, which the
# grader loads (RFD 0002). Build before grading: the grader builds nothing.

# Build the strategy into bot.wasm.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --release --target wasm32-wasip2
    cp target/wasm32-wasip2/release/mtx_bot_maker_wasm.wasm bot.wasm
    echo "built bot.wasm ($(wc -c < bot.wasm) bytes)"
