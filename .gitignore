# Cargo's builds, wherever a crate is: the workspace's, and those of bots and
# checks that build on their own (their logs too: `mtx bot practice` writes
# them under the bot's target/).
target/
/jobs
# `mtx grade`'s default log directory, when run from the root.
/logs/

# Local secrets (fork RPC key). Never commit.
.env

# A snapshot's accounts are committed gzipped (surfnet.json.gz, under 3 MB);
# the plain file is 175 MB, and mtx decompresses it into a cache itself.
snapshots/*/surfnet.json

.surfpool/
surfpool-mcp-schemas.json
__pycache__/

# Agent worktrees.
.claude/worktrees/
