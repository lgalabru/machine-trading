#!/usr/bin/env bash
# Grade /app/bot on the task's practice scenarios, exactly as the verifier
# grades it on the hidden ones. Pass scenario files to run others.
set -euo pipefail
if [ "$#" -eq 0 ]; then
  set -- /opt/mth/practice/*.json
fi
exec mth grade --snapshot "$MTH_SNAPSHOT" --bot "${MTH_BOT:-/app/bot}" --logs /tmp/mth-practice-logs "$@"
