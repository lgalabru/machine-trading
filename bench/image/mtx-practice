#!/usr/bin/env bash
# Grade /app/bot on the task's practice scenarios, exactly as the verifier
# grades it on the hidden ones. Pass scenario files to run others.
set -euo pipefail
if [ "$#" -eq 0 ]; then
  set -- /opt/mtx/practice/*.json
fi
# Three sessions at a time (MTX_JOBS to change): the world waits for the bot
# each step, so a session grades the same however many run beside it, and
# a sweep of practice grades fits in an agent's hour. One CPU stays free.
exec mtx grade --jobs "${MTX_JOBS:-3}" --snapshot "$MTX_SNAPSHOT" --bot "${MTX_BOT:-/app/bot}" --logs /tmp/mtx-practice-logs "$@"
