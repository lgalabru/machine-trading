#!/usr/bin/env bash
# Grade /app/bot on the task's practice scenarios, exactly as the verifier
# grades it on the hidden ones. Pass scenario files to run others.
set -euo pipefail
if [ "$#" -eq 0 ]; then
  set -- /opt/mt/practice/*.json
fi
exec mt grade --snapshot "$MT_SNAPSHOT" --bot "${MT_BOT:-/app/bot}" --logs /tmp/mt-practice-logs "$@"
