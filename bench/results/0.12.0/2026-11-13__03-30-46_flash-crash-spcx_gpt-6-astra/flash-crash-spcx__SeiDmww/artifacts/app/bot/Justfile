# Your strategy: `just build` builds it into bot.wasm, the component the
# grader loads. Build after every change: the grader loads bot.wasm as it
# is, and builds nothing.

# Build the strategy into bot.wasm.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    # The SDK target directory is shared with experimental crates.
    touch src/lib.rs
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    cp "$wasm" bot.wasm.new
    mv bot.wasm.new bot.wasm
    sha256sum bot.wasm > bot.sha256
    echo "built bot.wasm from $wasm"

# Check feature calculation and exported model predictions.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    touch src/lib.rs
    cargo test --lib
