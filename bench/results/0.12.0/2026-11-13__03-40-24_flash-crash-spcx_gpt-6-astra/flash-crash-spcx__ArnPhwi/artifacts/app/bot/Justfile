build:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    test -n "$wasm"
    cp "$wasm" bot.wasm.tmp
    mv -f bot.wasm.tmp bot.wasm
    echo "built bot.wasm from $wasm"

test:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    test_dir="$(mktemp -d /tmp/spcx-tests.XXXXXX)"
    trap 'rm -rf "$test_dir"' EXIT
    rustc --edition 2024 --test src/features.rs -o "$test_dir/features"
    "$test_dir/features"
    rustc --edition 2024 --test src/risk.rs -o "$test_dir/risk"
    "$test_dir/risk"
