# Build a self-contained strategy component; replace the artifact atomically.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    cp "$wasm" bot.wasm.next
    mv bot.wasm.next bot.wasm
    echo "built bot.wasm from $wasm"

# Native tests of the shared causal feature extraction, without a chain.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    task_test_dir="$(mktemp -d)"
    trap 'rm -rf "$task_test_dir"' EXIT
    rustc --edition 2024 --test src/features.rs -o "$task_test_dir/features"
    "$task_test_dir/features"
