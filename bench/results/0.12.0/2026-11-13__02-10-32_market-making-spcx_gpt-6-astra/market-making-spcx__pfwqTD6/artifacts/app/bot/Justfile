# Build the component atomically. The shared Cargo target directory can contain
# another experiment with the same package name; force this source to rebuild.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/cargo/bin:$PATH"
    touch src/lib.rs
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    test -n "$wasm"
    cp "$wasm" bot.wasm.tmp
    mv bot.wasm.tmp bot.wasm
    echo "built bot.wasm from $wasm"

test:
    PATH="/usr/local/cargo/bin:$PATH" cargo test --lib
