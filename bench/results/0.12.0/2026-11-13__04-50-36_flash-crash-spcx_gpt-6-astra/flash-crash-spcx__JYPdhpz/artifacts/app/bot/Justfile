# Your strategy: `just build` builds it into bot.wasm, the component the
# grader loads. Build after every change: the grader loads bot.wasm as it
# is, and builds nothing.

# Build the strategy into bot.wasm.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/rustup/toolchains/1.97.1-aarch64-unknown-linux-gnu/bin:$PATH"
    # Experiments share a target directory and crate name; invalidate only
    # this crate so Cargo cannot reuse another checkout's final artifact.
    touch src/lib.rs
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    cp "$wasm" bot.wasm
    echo "built bot.wasm from $wasm"

# Check causal features, compiled predictions, and the risk reserve.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="/usr/local/rustup/toolchains/1.97.1-aarch64-unknown-linux-gnu/bin:$PATH"
    test_bin="$(mktemp /tmp/spcx-tests.XXXXXX)"
    trap 'unlink "$test_bin"' EXIT
    rustc --edition 2024 --test tests/signal.rs -o "$test_bin"
    "$test_bin"
