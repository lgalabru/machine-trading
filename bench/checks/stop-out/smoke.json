{
  "name": "stop-out-smoke",
  "description": "SPCX dips 1.5%, then falls to 4.5% down and comes back: a bot that buys the dip draws down past its limit, and the risk desk closes it at the market",
  "symbol": "SPCX",
  "duration_slots": 200,
  "mandate": {
    "version": "v0",
    "universe": [
      {
        "instrument": "phoenix:perp:SPCX",
        "max_position": 200.0
      }
    ],
    "limits": {
      "max_drawdown_usd": 300.0
    }
  },
  "path": [
    {
      "slot": 20,
      "level_pct": -1.5
    },
    {
      "slot": 70,
      "level_pct": -4.5
    },
    {
      "slot": 140,
      "level_pct": 0.0
    }
  ],
  "stop_out": {
    "on": [
      "drawdown"
    ],
    "close": "market",
    "slice_base": 50.0
  }
}
