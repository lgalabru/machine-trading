# `just build` builds the informed bot's component, bot.wasm, which the
# ladder and the verifier run (a process trades the primary market only),
# and rungs/pro-rata/bot.wasm, the same bot holding each name to its share
# of the cap. The grader builds nothing: build before grading.

# Build bot.wasm and the pro-rata diagnostic.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    wasm() {
      env "$@" cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
        | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1
    }
    cp "$(wasm)" bot.wasm
    mkdir -p rungs/pro-rata
    cp "$(wasm MTX_B5_PRO_RATA=1)" rungs/pro-rata/bot.wasm
    echo "built bot.wasm and rungs/pro-rata/bot.wasm"
