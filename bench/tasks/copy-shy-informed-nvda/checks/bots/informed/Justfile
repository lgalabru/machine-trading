# `just build` builds bin/bot, the process the ladder and the verifier run
# as the task's informed bot (`just run` starts it).

# Build bin/bot.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    exe="$(cargo build --release --bin mtx-copy-shy-informed-informed --message-format=json-render-diagnostics \
      | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -1)"
    mkdir -p bin
    cp "$exe" bin/bot
    echo "built bin/bot"

# Start the process bot: what the grader runs for the anchor.
run:
    @exec ./bin/bot
