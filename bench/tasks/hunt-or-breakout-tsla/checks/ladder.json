{
  "anchors": {
    "informed": "informed",
    "reference": "reference"
  },
  "count": 72,
  "exploits": {
    "below": "informed",
    "bots": [],
    "max_profitable": 0.75
  },
  "family": "hunt-or-breakout",
  "gates": {
    "informed": [
      "informed"
    ],
    "non_reading": [
      "nop",
      "blind-long",
      "blind-short",
      "fade",
      "follow"
    ]
  },
  "min_rule_odds": 0.85,
  "probes": {},
  "rules": [
    "max(blind-long, blind-short) < reference",
    "max(fade, follow) < wait-oracle",
    "wait-oracle < reference",
    "reference < informed < hindsight",
    "push-fade < informed"
  ],
  "rungs": [
    {
      "dir": "bots/starter",
      "name": "nop"
    },
    {
      "dir": "bench/checks/ladder/blind-long",
      "may_breach": true,
      "name": "blind-long"
    },
    {
      "dir": "bench/checks/ladder/blind-short",
      "may_breach": true,
      "name": "blind-short"
    },
    {
      "dir": "bench/tasks/hunt-or-breakout-tsla/checks/bots/naive",
