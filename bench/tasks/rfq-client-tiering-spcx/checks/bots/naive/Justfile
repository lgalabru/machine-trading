# `just build` builds each rung's component into rungs/<rung>/bot.wasm: the
# rule is set at build time, since a component has no environment. The
# grader builds nothing: build before grading.

# Build every rung.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    rung() {
      local name=$1; shift
      wasm="$(env "$@" cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
        | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
      mkdir -p "rungs/$name"
      cp "$wasm" "rungs/$name/bot.wasm"
      echo "built rungs/$name/bot.wasm"
    }
    rung quote-all MTX_NAIVE=quote-all
    rung quote-wide MTX_NAIVE=quote-wide
    rung fixed-width MTX_NAIVE=fixed-width MTX_WIDTH=2
    rung size-tier MTX_NAIVE=size-tier MTX_TIER_N=5
    rung side-skew MTX_NAIVE=side-skew MTX_WINDOW=80 MTX_LEAN=0.1
    rung perp-front-run MTX_NAIVE=perp-front-run
