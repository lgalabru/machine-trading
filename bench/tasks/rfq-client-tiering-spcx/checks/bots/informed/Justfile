# `just build` builds bot.wasm, the component the ladder and the verifier
# run (RFQs reach components only), and bin/bot. The grader builds nothing:
# build before grading.

# Build bot.wasm and bin/bot.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    wasm="$(cargo build --release --lib --target wasm32-wasip2 --message-format=json-render-diagnostics \
      | sed -n 's/.*"filenames":\["\([^"]*\.wasm\)".*/\1/p' | tail -1)"
    cp "$wasm" bot.wasm
    exe="$(cargo build --release --bin mtx-rfq-client-tiering-informed --message-format=json-render-diagnostics \
      | sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' | tail -1)"
    mkdir -p bin
    cp "$exe" bin/bot
    echo "built bot.wasm and bin/bot"

# Start the process bot.
run:
    @exec ./bin/bot
